# LLM provider. Default is xAI (Grok) on the OpenAI-compatible API.
# xai | openai | anthropic | azure-openai | openai-compatible | local
LLM_PROVIDER=xai

# auto: live when LLM_API_KEY is set, otherwise the built-in demo (no network)
# mock: always demo, even if a key is present
# live: always call the provider
LLM_MODE=auto

# xAI keys come from https://console.x.ai
# Anthropic may use ANTHROPIC_API_KEY instead. Every other provider uses LLM_API_KEY.
LLM_API_KEY=

# Override the provider default. xAI default is https://api.x.ai/v1
LLM_BASE_URL=https://api.x.ai/v1

# Default model for every bot. xAI default is grok-4.7
LLM_MODEL=grok-4.7

# Optional per-bot model overrides. Unset bots use LLM_MODEL.
LLM_MODEL_LEAD=
LLM_MODEL_REQUIREMENTS=
LLM_MODEL_PROCESS_QA=
LLM_MODEL_DRAWING_QA=
LLM_MODEL_SPECIFICATIONS=
LLM_MODEL_SUBMISSION=

# auto sends response_format=json_object on OpenAI-compatible providers.
# prompt asks for JSON in the prompt only (required for some local models).
# Anthropic always uses prompt mode.
LLM_JSON_MODE=auto

# Azure OpenAI only. LLM_BASE_URL is https://YOUR_RESOURCE.openai.azure.com
# LLM_MODEL or AZURE_OPENAI_DEPLOYMENT is the deployment name.
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

# Optional dedicated Anthropic key. Falls back to LLM_API_KEY.
ANTHROPIC_API_KEY=
